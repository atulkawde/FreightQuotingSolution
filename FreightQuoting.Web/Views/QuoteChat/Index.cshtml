@{
    ViewData["Title"] = "Enterprise Freight Quoting Agent";
}

<div class="container-fluid py-4">
    <div class="row g-4">
        
        <!-- LEFT COLUMN: Customer Chat Window -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h5 class="mb-0">FreightOps Quote Assistant</h5>
                        <small class="text-light opacity-75">Powered by Microsoft Semantic Kernel & Azure AI Foundry</small>
                    </div>
                    <button id="clearChatBtn" class="btn btn-outline-light btn-sm">New Quote Session</button>
                </div>

                <!-- Chat History Feed -->
                <div id="chatWindow" class="card-body overflow-auto bg-light" style="height: 500px;">
                    <div class="d-flex flex-column mb-3">
                        <div class="bg-white border rounded p-3 shadow-sm" style="max-width: 80%;">
                            <strong class="text-primary d-block mb-1">Quote Agent</strong>
                            <span>Welcome! Tell me what you need to ship (origin, destination, and cargo details), and I will calculate your contract rate and compliance requirements.</span>
                        </div>
                    </div>
                </div>

                <!-- Quick Starter Prompts for Testing -->
                <div class="card-footer bg-white border-top-0 pt-2 pb-0">
                    <small class="text-muted d-block mb-1">Quick Test Scenarios:</small>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm starter-prompt">
                            Move 4 pallets of medical supplies from Chicago to Dallas (keep under 40F)
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm starter-prompt">
                            Ship 10 pallets of dry electronics to Atlanta
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm starter-prompt">
                            From Minneapolis
                        </button>
                    </div>
                </div>

                <!-- Message Input Form -->
                <div class="card-footer bg-white py-3">
                    <form id="chatForm" class="d-flex gap-2">
                        <input type="text" id="userMessageInput" class="form-control" 
                               placeholder="Describe your shipment (e.g., 4 pallets of medical supplies from Chicago to Dallas)..." 
                               required autocomplete="off" />
                        <button type="submit" id="sendBtn" class="btn btn-primary px-4">
                            Send
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Live MLOps & Agent Telemetry Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0">Agent Telemetry & Trace</h5>
                    <small class="opacity-75">Real-time Semantic Kernel Execution Audit</small>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    
                    <div>
                        <!-- Token & Cost Metrics -->
                        <h6 class="text-uppercase text-muted small fw-bold mb-3">Compute & Token Metrics</h6>
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="border rounded p-2 bg-light text-center">
                                    <small class="text-muted d-block">Prompt Tokens</small>
                                    <span id="promptTokensVal" class="fs-5 fw-bold text-dark">0</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded p-2 bg-light text-center">
                                    <small class="text-muted d-block">Completion Tokens</small>
                                    <span id="completionTokensVal" class="fs-5 fw-bold text-dark">0</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="border rounded p-2 bg-light text-center">
                                    <small class="text-muted d-block">Cumulative Session Cost (USD)</small>
                                    <span id="totalCostVal" class="fs-4 fw-bold text-success">$0.000000</span>
                                </div>
                            </div>
                        </div>

                        <!-- Execution Path Trace -->
                        <h6 class="text-uppercase text-muted small fw-bold mb-2">Latest Turn Execution Path</h6>
                        <div id="executionPathList" class="list-group list-group-flush border rounded overflow-auto" style="max-height: 260px;">
                            <div class="list-group-item text-muted small fst-italic">
                                Waiting for first message...
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info small mb-0 mt-3">
                        <strong>Chaos Monkey Active:</strong> Primary contract pricing has a 30% simulated HTTP 500 timeout rate to demonstrate automatic spot-market recovery.
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const chatForm = document.getElementById('chatForm');
        const userInput = document.getElementById('userMessageInput');
        const chatWindow = document.getElementById('chatWindow');
        const sendBtn = document.getElementById('sendBtn');
        const clearChatBtn = document.getElementById('clearChatBtn');

        let cumulativePromptTokens = 0;
        let cumulativeCompletionTokens = 0;
        let cumulativeCostUsd = 0;

        // Starter prompt buttons
        document.querySelectorAll('.starter-prompt').forEach(btn => {
            btn.addEventListener('click', () => {
                userInput.value = btn.textContent.trim();
                chatForm.dispatchEvent(new Event('submit'));
            });
        });

        // Reset session button
        clearChatBtn.addEventListener('click', async () => {
            await fetch('/QuoteChat/ResetSession', { method: 'POST' });
            location.reload();
        });

        // Handle chat submission
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = userInput.value.trim();
            if (!message) return;

            appendMessage('You', message, true);
            userInput.value = '';
            setLoadingState(true);

            try {
                const response = await fetch('/QuoteChat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });

                if (!response.ok) throw new Error('Server returned ' + response.status);

                const data = await response.json();
                appendMessage('Quote Agent', data.replyMessage, false);
                updateTelemetry(data);
            } catch (err) {
                appendMessage('System Error', 'Failed to communicate with quoting agent: ' + err.message, false, true);
            } finally {
                setLoadingState(false);
            }
        });

        function appendMessage(sender, text, isUser, isError = false) {
            const wrapper = document.createElement('div');
            wrapper.className = `d-flex flex-column mb-3 ${isUser ? 'align-items-end' : 'align-items-start'}`;

            const bubble = document.createElement('div');
            bubble.className = isUser 
                ? 'bg-primary text-white rounded p-3 shadow-sm' 
                : (isError ? 'bg-danger text-white rounded p-3 shadow-sm' : 'bg-white border rounded p-3 shadow-sm');
            bubble.style.maxWidth = '80%';
            bubble.style.whiteSpace = 'pre-wrap';

            const title = document.createElement('strong');
            title.className = `d-block mb-1 ${isUser || isError ? 'text-white' : 'text-primary'}`;
            title.textContent = sender;

            const body = document.createElement('span');
            body.textContent = text;

            bubble.appendChild(title);
            bubble.appendChild(body);
            wrapper.appendChild(bubble);
            chatWindow.appendChild(wrapper);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        function updateTelemetry(data) 
        {
            cumulativePromptTokens += data.promptTokens;
            cumulativeCompletionTokens += data.completionTokens;
            cumulativeCostUsd += data.totalCostUsd;

            document.getElementById('promptTokensVal').textContent = cumulativePromptTokens.toLocaleString();
            document.getElementById('completionTokensVal').textContent = cumulativeCompletionTokens.toLocaleString();
            document.getElementById('totalCostVal').textContent = '$' + cumulativeCostUsd.toFixed(6);

            const list = document.getElementById('executionPathList');
            list.innerHTML = '';

            data.executionPath.forEach((step, idx) => {
            const item = document.createElement('div');
            const isError = step.includes('ERROR') || step.includes('HALTED');
            const isFallback = step.includes('Fallback');
            item.className = 'list-group-item small d-flex justify-content-between align-items-center';
            if (isError) 
                item.classList.add('list-group-item-danger');
            else if (isFallback) 
                item.classList.add('list-group-item-warning');
            item.innerHTML = `<span><strong>${idx + 1}.</strong> ${step}</span>`;
            list.appendChild(item);
        });
        }

        function setLoadingState(isLoading) {
            userInput.disabled = isLoading;
            sendBtn.disabled = isLoading;
            sendBtn.textContent = isLoading ? 'Orchestrating...' : 'Send';
        }
</script>
}